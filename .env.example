# Snowflake connection for Live mode. Copy to .env.local (gitignored) and fill in.
# Without .env.local the app runs in Sample mode on bundled synthetic data.
SNOWFLAKE_ACCOUNT=<orgname>-<account_name>
SNOWFLAKE_USERNAME=<YOUR_USER>
SNOWFLAKE_ROLE=AUTO_FINANCE_DEMO_ROLE
SNOWFLAKE_DATABASE=AUTO_FINANCE_EXAMPLE
SNOWFLAKE_SCHEMA=LENDING
SNOWFLAKE_WAREHOUSE=AUTO_FINANCE_WH
SNOWFLAKE_AGENT_NAME=AUTO_FINANCE_EXAMPLE.LENDING.AUTO_FINANCE_AGENT
# Model for the dealer narrative (AI_COMPLETE). Use any model available in your region.
# SNOWFLAKE_COMPLETE_MODEL=claude-sonnet-4-5

# Authentication — choose ONE method.

# Option 1: Key pair (recommended). Keep the key OUTSIDE this repository:
#   mkdir -p ~/.snowflake/keys
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out ~/.snowflake/keys/auto_finance_key.p8 -nocrypt
#   openssl rsa -in ~/.snowflake/keys/auto_finance_key.p8 -pubout
#   ALTER USER <YOUR_USER> SET RSA_PUBLIC_KEY_2 = '<public key body without header lines>';
# SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/.snowflake/keys/auto_finance_key.p8

# Option 2: Programmatic access token
# SNOWFLAKE_TOKEN=<token>

# Option 3: External browser SSO (interactive sessions only)
# SNOWFLAKE_BROWSER_AUTH=true

# Option 4: Password (development only)
# SNOWFLAKE_PASSWORD=<password>
